APP_ENV=production
ADMIN_USERNAME=admin
# Required: generate on the server, do not commit real values.
ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_MINUTES=720
CORS_ORIGINS=https://serenity.zenithy.art,http://127.0.0.1:5173,http://localhost:5173

POSTGRES_DB=serenity
POSTGRES_USER=serenity
# Required: generate on the server before running Docker Compose.
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
ENABLE_TASK_ENQUEUE=true
SERENITY_BACKEND_PORT=8000
SERENITY_FRONTEND_PORT=5173
SHARED_CADDY_NETWORK=shared_gateway

# Optional build mirrors. Keep official defaults unless Docker Hub or package registries are slow.
PYTHON_IMAGE=python:3.11-slim
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine
APT_MIRROR_HOST=
PIP_INDEX_URL=https://pypi.org/simple
PIP_EXTRA_INDEX_URL=
PIP_TRUSTED_HOST=
NPM_REGISTRY=https://registry.npmjs.org/

X_ACCOUNT_HANDLE=aleabitoreddit
X_MAX_RESULTS=10
X_MAX_PAGES=3
POLL_INTERVAL_SECONDS=180

X_BEARER_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
COS_ENDPOINT=
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_SECRET_ID=
COS_SECRET_KEY=
COS_PUBLIC_BASE_URL=
